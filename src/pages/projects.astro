---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  title: string;
  description: string;
  tech: string[];
  liveUrl: string | null;
  repoUrl: string | null;
}

const projects: Project[] = [
  {
    title: 'US County Health Analysis',
    description:
      'A full-stack data analytics project exploring county-level public health trends across the US — 293K+ observations spanning 12 health measures and ~3,000 counties. Includes an ETL pipeline, a PostgreSQL database, a Flask API, and an interactive Plotly Dash dashboard.',
    tech: ['Python', 'pandas', 'PostgreSQL', 'Flask', 'Plotly Dash'],
    liveUrl: 'https://us-county-health-dashboard.onrender.com',
    repoUrl: 'https://github.com/jpierre-7/us-county-health-analysis',
  },
  {
    title: 'Dotfiles',
    description:
      'My personal Arch Linux configuration, managed with GNU Stow. A reproducible setup built around the Niri Wayland compositor, with bootstrap scripts and configs for Fish, Neovim, WezTerm, and Starship.',
    tech: ['Arch Linux', 'GNU Stow', 'Niri', 'Fish', 'Neovim'],
    liveUrl: null,
    repoUrl: 'https://github.com/jpierre-7/dotfiles',
  },
  {
    title: 'Intro to Machine Learning (ITAI 1371)',
    description:
      'Coursework and projects from my Introduction to ML course at Houston City College. Notebooks cover the full workflow — EDA, feature engineering, regression and classification, ensemble methods, unsupervised learning, and model evaluation.',
    tech: ['Python', 'Jupyter', 'scikit-learn'],
    liveUrl: null,
    repoUrl: 'https://github.com/jpierre-7/ITAI_1371_ML_Course',
  },
];
---

<BaseLayout title="Projects" description="Projects by John Pierre">
  <h1 class="text-4xl font-bold mb-8">Projects</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body flex flex-col">
          <h2 class="card-title">{project.title}</h2>
          <p class="text-sm opacity-70 flex-1">{project.description}</p>

          <!-- Tech stack badges -->
          <div class="flex flex-wrap gap-1 mt-3">
            {project.tech.map((t) => (
              <span class="badge badge-primary badge-sm">{t}</span>
            ))}
          </div>

          <div class="card-actions justify-end mt-4">
            {project.repoUrl && (
              <a href={project.repoUrl} class="btn btn-ghost btn-xs" target="_blank" rel="noopener">
                Repo
              </a>
            )}
            {project.liveUrl && (
              <a href={project.liveUrl} class="btn btn-primary btn-xs" target="_blank" rel="noopener">
                View
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
