---
/*
  ASTRO FRONTMATTER
  The code between the --- fences runs at BUILD TIME on the server.
*/
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

/*
  Props are the public API of this component.
*/
interface Props {
  title: string;
  description?: string;
}

const { title, description = "John Pierre's personal website" } = Astro.props;

const faviconHref = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, '/');
---

<!doctype html>
<html lang="en" data-theme="gruvbox">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title} | JP</title>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <Header />
    <main class="flex-1 container mx-auto px-4 py-8 max-w-5xl">
      <slot />
    </main>
    <Footer />
  </body>
</html>
