---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "John Pierre — Coach @ Major League Hacking, President @ CSA (HCC), Developer & Data Analyst",
} = Astro.props;

const faviconHref = `${import.meta.env.BASE_URL}/favicon.svg`.replace(
    /\/{2,}/g,
    "/",
);
const canonicalUrl = new URL(
    Astro.url.pathname,
    Astro.site || "https://7jpierre.github.io",
);
---

<!doctype html>
<html lang="en" data-theme="gruvbox">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#1d2021" />

        <!-- Open Graph / Meta -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl.href} />
        <meta property="og:title" content={`${title} | John Pierre`} />
        <meta property="og:description" content={description} />
        <meta property="twitter:card" content="summary" />
        <meta property="twitter:title" content={`${title} | John Pierre`} />
        <meta property="twitter:description" content={description} />

        <link rel="icon" type="image/svg+xml" href={faviconHref} />
        <title>{title} | John Pierre</title>
    </head>
    <body
        class="min-h-screen flex flex-col bg-gruvbox-dark0_hard text-gruvbox-light1 relative overflow-x-hidden selection:bg-primary/30 selection:text-primary"
    >
        <!-- Skip to content for accessibility -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-content focus:rounded-md focus:font-mono focus:text-sm shadow-lg"
        >
            Skip to content
        </a>

        <!-- Subtle ambient lighting -->
        <div
            class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full"
        >
        </div>
        <div
            class="fixed bottom-0 right-10 w-[500px] h-[300px] bg-secondary/5 blur-[100px] pointer-events-none -z-10 rounded-full"
        >
        </div>

        <Header />
        <main
            id="main-content"
            class="flex-1 container mx-auto px-4 sm:px-6 lg:px-8 py-10 max-w-5xl"
        >
            <slot />
        </main>
        <Footer />
    </body>
</html>
