---
const withBase = (path: string) =>
    `${import.meta.env.BASE_URL}/${path}`.replace(/\/{2,}/g, "/");

const navLinks = [
    { href: withBase(""), label: "Home" },
    { href: withBase("projects"), label: "Projects" },
    { href: withBase("about"), label: "About" },
];

const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = norm(Astro.url.pathname);
---

<header
    class="sticky top-0 z-50 backdrop-blur-md bg-[#1d2021]/85 border-b border-[#3c3836]/60 transition-colors"
>
    <div class="navbar container mx-auto max-w-5xl px-4 sm:px-6 py-3">
        <!-- Brand Logo -->
        <div class="navbar-start">
            <a
                href={withBase("")}
                class="group inline-flex items-center gap-2 font-mono font-bold text-lg tracking-tight text-gruvbox-light1 hover:text-primary transition-all duration-200"
            >
                <span class="text-primary font-mono select-none">&gt;_</span>
                <span>jpierre</span>
                <span class="inline-block w-1.5 h-4 bg-primary/80 animate-pulse"
                ></span>
            </a>
        </div>

        <!-- Desktop nav links -->
        <nav
            class="navbar-end hidden md:flex items-center gap-1.5 font-mono text-sm"
        >
            {
                navLinks.map(({ href, label }) => {
                    const isActive = currentPath === norm(href);
                    return (
                        <a
                            href={href}
                            class:list={[
                                "px-3.5 py-1.5 rounded-md transition-all duration-200",
                                isActive
                                    ? "bg-[#3c3836] text-primary font-medium border border-primary/30 shadow-sm"
                                    : "text-gruvbox-light3 hover:text-gruvbox-light0 hover:bg-[#32302f]",
                            ]}
                        >
                            {label}
                        </a>
                    );
                })
            }

            <div class="w-px h-4 bg-[#504945] mx-2"></div>

            <!-- Quick GitHub link -->
            <a
                href="https://github.com/jpierre-7"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub Profile"
                class="p-2 rounded-md text-gruvbox-light3 hover:text-primary hover:bg-[#32302f] transition-all duration-200"
            >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path
                        d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                    ></path>
                </svg>
            </a>
        </nav>

        <!-- Mobile menu button -->
        <div class="navbar-end md:hidden">
            <div class="dropdown dropdown-end">
                <button
                    tabindex="0"
                    class="btn btn-ghost btn-sm btn-square text-gruvbox-light1"
                    aria-label="Open menu"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                <ul
                    tabindex="0"
                    class="menu menu-sm dropdown-content mt-3 z-[50] p-2 shadow-xl bg-[#282828] border border-[#504945] rounded-lg w-44 font-mono"
                >
                    {
                        navLinks.map(({ href, label }) => {
                            const isActive = currentPath === norm(href);
                            return (
                                <li>
                                    <a
                                        href={href}
                                        class:list={[
                                            "rounded-md py-2",
                                            isActive
                                                ? "bg-[#3c3836] text-primary font-semibold"
                                                : "text-gruvbox-light2 hover:text-gruvbox-light0",
                                        ]}
                                    >
                                        {label}
                                    </a>
                                </li>
                            );
                        })
                    }
                    <div class="divider my-1 opacity-20"></div>
                    <li>
                        <a
                            href="https://github.com/jpierre-7"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gruvbox-light3 hover:text-primary py-2"
                        >
                            GitHub ↗
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
